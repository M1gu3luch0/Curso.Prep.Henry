{
  "name": "ps1-induccion",
  "version": "1.0.0",
  "description": "Vídeo educativo de un fogón de inducción en estilo PS1, cel-shading e infografía isométrica (Three.js)",
  "scripts": {
    "render": "node render.mjs",
    "render:cel": "node render.mjs --estilo=cel",
    "render:iso": "node render.mjs --estilo=iso",
    "fotos": "node render.mjs --fotos=3,10,18,26,36,46,55,64,76",
    "fotos:cel": "node render.mjs --estilo=cel --fotos=3,10,18,26,36,46,55,64,76",
    "fotos:iso": "node render.mjs --estilo=iso --fotos=3,10,18,26,36,46,55,64,76"
  },
  "license": "ISC",
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "type": "module"
}
